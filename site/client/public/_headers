# Fonts are content-addressed by name and replaced wholesale when they change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Vite fingerprints these, so a change ships under a new name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Story art and covers change rarely and are not fingerprinted.
/stories/*
  Cache-Control: public, max-age=604800

# The worker must never be served from a stale cache, or an old one keeps
# control after a deploy.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Memorization journey art. Not fingerprinted; replaced rarely, in batches.
/hifz-art/*
  Cache-Control: public, max-age=604800

# The Quran text of one surah. Revealed fourteen centuries ago and not about
# to change; a week of caching costs a returning reader nothing.
/quran/*
  Cache-Control: public, max-age=604800

# Which recitations exist, and where one surah's audio lives. Changed only when
# a recitation is added.
/recitations/*
  Cache-Control: public, max-age=604800

# Audio manifest.
/manus-storage/*
  Cache-Control: public, max-age=86400
