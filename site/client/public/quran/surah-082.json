{"s":82,"a":[{"n":1,"t":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","r":"Izas samaaa'un fatarat"},{"n":2,"t":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","r":"Wa izal kawaakibun tasarat"},{"n":3,"t":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","r":"Wa izal bihaaru fujjirat"},{"n":4,"t":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","r":"Wa izal qubooru bu'sirat"},{"n":5,"t":"عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ","r":"'Alimat nafsum maa qaddamat wa akhkharat"},{"n":6,"t":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","r":"Yaaa ayyuhal insaaanu maa gharraka bi Rabbikal kareem"},{"n":7,"t":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","r":"Allazee khalaqaka fasaw waaka fa'adalak"},{"n":8,"t":"فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ","r":"Feee ayye sooratim maa shaaa'a rakkabak"},{"n":9,"t":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","r":"Kalla bal tukazziboona bid deen"},{"n":10,"t":"وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ","r":"Wa inna 'alaikum lahaa fizeen"},{"n":11,"t":"كِرَامًۭا كَـٰتِبِينَ","r":"Kiraaman kaatibeen"},{"n":12,"t":"يَعْلَمُونَ مَا تَفْعَلُونَ","r":"Ya'lamoona ma taf'aloon"},{"n":13,"t":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ","r":"Innal abraara lafee na'eem"},{"n":14,"t":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ","r":"Wa innal fujjaara lafee jaheem"},{"n":15,"t":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","r":"Yaslawnahaa Yawmad Deen"},{"n":16,"t":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","r":"Wa maa hum 'anhaa bighaaa 'ibeen"},{"n":17,"t":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","r":"Wa maaa adraaka maa Yawmud Deen"},{"n":18,"t":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","r":"Summa maaa adraaka maa Yawmud Deen"},{"n":19,"t":"يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ","r":"Yawma laa tamliku nafsul linafsin shai'anw walamru yawma'izil lillaah"}]}