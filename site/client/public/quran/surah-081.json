{"s":81,"a":[{"n":1,"t":"إِذَا ٱلشَّمْسُ كُوِّرَتْ","r":"Izash shamsu kuwwirat"},{"n":2,"t":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","r":"Wa izan nujoomun kadarat"},{"n":3,"t":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","r":"Wa izal jibaalu suyyirat"},{"n":4,"t":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","r":"Wa izal 'ishaaru 'uttilat"},{"n":5,"t":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","r":"Wa izal wuhooshu hushirat"},{"n":6,"t":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","r":"Wa izal bihaaru sujjirat"},{"n":7,"t":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","r":"Wa izan nufoosu zuwwijat"},{"n":8,"t":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","r":"Wa izal maw'oodatu su'ilat"},{"n":9,"t":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","r":"Bi ayyi zambin qutilat"},{"n":10,"t":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","r":"Wa izas suhufu nushirat"},{"n":11,"t":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","r":"Wa izas samaaa'u kushitat"},{"n":12,"t":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","r":"Wa izal jaheemu su'-'irat"},{"n":13,"t":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","r":"Wa izal jannatu uzlifat"},{"n":14,"t":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","r":"'Alimat nafsum maaa ahdarat"},{"n":15,"t":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","r":"Falaaa uqsimu bil khunnas"},{"n":16,"t":"ٱلْجَوَارِ ٱلْكُنَّسِ","r":"Al jawaaril kunnas"},{"n":17,"t":"وَٱلَّيْلِ إِذَا عَسْعَسَ","r":"Wallaili izaa 'as'as"},{"n":18,"t":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","r":"Wassubhi izaa tanaffas"},{"n":19,"t":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","r":"Innahoo laqawlu rasoolin kareem"},{"n":20,"t":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","r":"Zee quwwatin 'inda zil 'arshi makeen"},{"n":21,"t":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","r":"Mutaa'in samma ameen"},{"n":22,"t":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","r":"Wa maa saahibukum bimajnoon"},{"n":23,"t":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","r":"Wa laqad ra aahu bilufuqil mubeen"},{"n":24,"t":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","r":"Wa maa huwa 'alal ghaibi bidaneen"},{"n":25,"t":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍۢ رَّجِيمٍۢ","r":"Wa maa huwa biqawli shaitaanir rajeem"},{"n":26,"t":"فَأَيْنَ تَذْهَبُونَ","r":"Fa ayna tazhaboon"},{"n":27,"t":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَـٰلَمِينَ","r":"In huwa illaa zikrul lil'aalameen"},{"n":28,"t":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","r":"Liman shaaa'a minkum ai yastaqeem"},{"n":29,"t":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ","r":"Wa maa tashaaa'oona illaaa ai yashaaa 'al laahu Rabbul 'Aalameen"}]}