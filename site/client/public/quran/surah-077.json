aaa'anw wa amwaataa"},{"n":27,"t":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍۢ وَأَسْقَيْنَـٰكُم مَّآءًۭ فُرَاتًۭا","r":"Wa ja'alnaa feehaa rawaasiya shaamikhaatinw wa asqainaakum maaa'an furaataa"},{"n":28,"t":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","r":"Wailuny yawma 'izil lilmukazzibeen"},{"n":29,"t":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","r":"Intaliqooo ilaa maa kuntum bihee tukazziboon"},{"n":30,"t":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَـٰثِ شُعَبٍۢ","r":"Intaliqooo ilaa zillin zee salaasi shu'ab"},{"n":31,"t":"لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","r":"Laa zaleelinw wa laa yughnee minal lahab"},{"n":32,"t":"إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ","r":"Innahaa tarmee bishararin kalqasr"},{"n":33,"t":"كَأَنَّهُۥ جِمَـٰلَتٌۭ صُفْرٌۭ","r":"Ka annahoo jimaalatun sufr"},{"n":34,"t":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","r":"Wailuny yawma 'izil lilmukazibeen"},{"n":35,"t":"هَـٰذَا يَوْمُ لَا يَنطِقُونَ","r":"Haazaa yawmu laa uantiqoon"},{"n":36,"t":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","r":"Wa laa yu'zanu lahum fa ya'taziroon"},{"n":37,"t":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","r":"Wailunw yawma 'izil lilmukazzibeen"},{"n":38,"t":"هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ","r":"Haaza yawmul fasli jama 'naakum wal awwaleen"},{"n":39,"t":"فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ","r":"Fa in kaana lakum kaidun fakeedoon"},{"n":40,"t":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","r":"Wailuny yawma'izil lilmukazzibeen"},{"n":41,"t":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍۢ وَعُيُونٍۢ","r":"Innal muttaqeena fee zilaalinw wa 'uyoon"},{"n":42,"t":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","r":"Wa fawaakiha mimmaa yastahoon"},{"n":43,"t":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","r":"Kuloo washraboo haneee 'am bimaa kuntum ta'maloon"},{"n":44,"t":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","r":"Innaa kazaalika najzil muhsineen"},{"n":45,"t":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","r":"Wailuny yawma 'izil lilmuzkazzibeen"},{"n":46,"t":"كُلُوا۟ وَ