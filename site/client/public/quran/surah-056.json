{"s":56,"a":[{"n":1,"t":"إِذَا وَقَعَتِ ٱلْوَاقِعَةُ","r":"Izaa waqa'atil waaqi'ah"},{"n":2,"t":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ","r":"Laisa liwaq'atihaa kaazibah"},{"n":3,"t":"خَافِضَةٌۭ رَّافِعَةٌ","r":"Khafidatur raafi'ah"},{"n":4,"t":"إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا","r":"Izaa rujjatil ardu rajjaa"},{"n":5,"t":"وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا","r":"Wa bussatil jibaalu bassaa"},{"n":6,"t":"فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا","r":"Fakaanat habaaa'am mumbassaa"},{"n":7,"t":"وَكُنتُمْ أَزْوَٰجًۭا ثَلَـٰثَةًۭ","r":"Wa kuntum azwaajan salaasah"},{"n":8,"t":"فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ","r":"Fa as haabul maimanati maaa as haabul maimanah"},{"n":9,"t":"وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ","r":"Wa as haabul mash'amati maaa as haabul mash'amah"},{"n":10,"t":"وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ","r":"Wassaabiqoonas saabiqoon"},{"n":11,"t":"أُو۟لَـٰٓئِكَ ٱلْمُقَرَّبُونَ","r":"Ulaaa'ikal muqarraboon"},{"n":12,"t":"فِى جَنَّـٰتِ ٱلنَّعِيمِ","r":"Fee Jannaatin Na'eem"},{"n":13,"t":"ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ","r":"Sullatum minal awwaleen"},{"n":14,"t":"وَقَلِيلٌۭ مِّنَ ٱلْـَٔاخِرِينَ","r":"Wa qaleelum minal aa khireen"},{"n":15,"t":"عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ","r":"'Alaa sururim mawdoonah"},{"n":16,"t":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَـٰبِلِينَ","r":"Muttaki'eena 'alaihaa mutaqabileen"},{"n":17,"t":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ","r":"Yatoofu 'alaihim wildaa num mukkhalladoon"},{"n":18,"t":"بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ","r":"Bi akwaabinw wa abaareeq, wa kaasim mim ma'een"},{"n":19,"t":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ","r":"Laa yusadda'oona 'anhaa wa laa yunzifoon"},{"n":20,"t":"وَفَـٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ","r":"Wa faakihatim mimmaa yatakhaiyaroon"},{"n":21,"t":"وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ","r":"Wa lahmi tairim mimmaa yashtahoon"},{"n":22,"t":"وَحُورٌ عِينٌۭ","r":"Wa hoorun'een"},{"n":23,"t":"كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ","r":"Ka amsaalil lu'lu'il maknoon"},{"n":24,"t":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ","r":"Jazaaa'am bimaa kaanoo ya'maloon"},{"n":25,"t":"لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا","r":"Laa yasma'oona feehaa laghwanw wa laa taaseemaa"},{"n":26,"t":"إِلَّا قِيلًۭا سَلَـٰمًۭا سَلَـٰمًۭا","r":"Illaa qeelan salaaman salaamaa"},{"n":27,"t":"وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ","r":"Wa as haabul yameeni maaa as haabul Yameen"},{"n":28,"t":"فِى سِدْرٍۢ مَّخْضُودٍۢ","r":"Fee sidrim makhdood"},{"n":29,"t":"وَطَلْحٍۢ مَّنضُودٍۢ","r":"Wa talhim mandood"},{"n":30,"t":"وَظِلٍّۢ مَّمْدُودٍۢ","r":"Wa zillim mamdood"},{"n":31,"t":"وَمَآءٍۢ مَّسْكُوبٍۢ","r":"Wa maaa'im maskoob"},{"n":32,"t":"وَفَـٰكِهَةٍۢ كَثِيرَةٍۢ","r":"Wa faakihatin kaseerah"},{"n":33,"t":"لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ","r":"Laa maqtoo'atinw wa laa mamnoo'ah"},{"n":34,"t":"وَفُرُشٍۢ مَّرْفُوعَةٍ","r":"Wa furushim marfoo'ah"},{"n":35,"t":"إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءًۭ","r":"Innaaa anshaanaahunna inshaaa'aa"},{"n":36,"t":"فَجَعَلْنَـٰهُنَّ أَبْكَارًا","r":"Faja'alnaahunna abkaaraa"},{"n":37,"t":"عُرُبًا أَتْرَابًۭا","r":"'Uruban atraabaa"},{"n":38,"t":"لِّأَصْحَـٰبِ ٱلْيَمِينِ","r":"Li as haabil yameen"},{"n":39,"t":"ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ","r":"Sullatum minal awwa leen"},{"n":40,"t":"وَثُلَّةٌۭ مِّنَ ٱلْـَٔاخِرِينَ","r":"Wa sullatum minal aakhireen"},{"n":41,"t":"وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ","r":"Wa as haabush shimaali maaa as haabush shimaal"},{"n":42,"t":"فِى سَمُومٍۢ وَحَمِيمٍۢ","r":"Fee samoominw wa hameem"},{"n":43,"t":"وَظِلٍّۢ مِّن يَحْمُومٍۢ","r":"Wa zillim miny yahmoom"},{"n":44,"t":"لَّا بَارِدٍۢ وَلَا كَرِيمٍ","r":"Laa baaridinw wa laa kareem"},{"n":45,"t":"إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ","r":"Innaahum kaanoo qabla zaalika mutrafeen"},{"n":46,"t":"وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ","r":"Wa kaanoo yusirroona 'alal hinsil 'azeem"},{"n":47,"t":"وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ","r":"Wa kaanoo yaqooloona a'izaa mitnaa wa kunnaa turaabanw wa izaaman'ainnaa lamab'oosoon"},{"n":48,"t":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","r":"Awa aabaaa'unal awwaloon"},{"n":49,"t":"قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ","r":"Qul innal awwaleena wal aakhireen"},{"n":50,"t":"لَمَجْمُوعُونَ إِلَىٰ مِيقَـٰتِ يَوْمٍۢ مَّعْلُومٍۢ","r":"Lamajmoo'oona ilaa meeqaati yawmim ma'loon"},{"n":51,"t":"ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ","r":"summa innakum ayyuhad daaalloonal mukazziboon"},{"n":52,"t":"لَـَٔاكِلُونَ مِن شَجَرٍۢ مِّن زَقُّومٍۢ","r":"La aakiloona min shaja rim min zaqqoom"},{"n":53,"t":"فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","r":"Famaali'oona minhal butoon"},{"n":54,"t":"فَشَـٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ","r":"Fashaariboona 'alaihi minal hameem"},{"n":55,"t":"فَشَـٰرِبُونَ شُرْبَ ٱلْهِيمِ","r":"Fashaariboona shurbal heem"},{"n":56,"t":"هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ","r":"Haazaa nuzuluhum yawmad deen"},{"n":57,"t":"نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ","r":"Nahnu khalaqnaakum falaw laa tusaddiqoon"},{"n":58,"t":"أَفَرَءَيْتُم مَّا تُمْنُونَ","r":"Afara'aytum maa tumnoon"},{"n":59,"t":"ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ","r":"'A-antum takhluqoo nahooo am nahnul khaaliqoon"},{"n":60,"t":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ","r":"Nahnu qaddarnaa baina kumul mawta wa maa nahnu bimasbooqeen"},{"n":61,"t":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ","r":"'Alaaa an nubaddila amsaalakum wa nunshi'akum fee maa laa ta'lamoon"},{"n":62,"t":"وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ","r":"Wa laqad 'alimtumun nash atal oolaa falaw laa tazakkaroon"},{"n":63,"t":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ","r":"Afara'aytum maa tahrusoon"},{"n":64,"t":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ","r":"'A-antum tazra'oonahooo am nahnuz zaari'ooon"},{"n":65,"t":"لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًۭا فَظَلْتُمْ تَفَكَّهُونَ","r":"Law nashaaa'u laja'al naahu hutaaman fazaltum tafakkahoon"},{"n":66,"t":"إِنَّا لَمُغْرَمُونَ","r":"Innaa lamughramoon"},{"n":67,"t":"بَلْ نَحْنُ مَحْرُومُونَ","r":"Bal nahnu mahroomoon"},{"n":68,"t":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ","r":"Afara'aytumul maaa'allazee tashraboon"},{"n":69,"t":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ","r":"'A-antum anzaltumoohu minal muzni am nahnul munziloon"},{"n":70,"t":"لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًۭا فَلَوْلَا تَشْكُرُونَ","r":"Law nashaaa'u ja'alnaahu ujaajan falaw laa tashkuroon"},{"n":71,"t":"أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ","r":"Afara'aytumun naaral latee tooroon"},{"n":72,"t":"ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ","r":"'A-antum anshaatum shajaratahaaa am nahnul munshi'oon"},{"n":73,"t":"نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةًۭ وَمَتَـٰعًۭا لِّلْمُقْوِينَ","r":"Nahnu ja'alnaahaa tazkira tanw wa mataa'al lilmuqween"},{"n":74,"t":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","r":"Fasabbih bismi Rabbikal 'azeem"},{"n":75,"t":"۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ","r":"Falaa uqsimu bimaawaa qi'innujoom"},{"n":76,"t":"وَإِنَّهُۥ لَقَسَمٌۭ لَّوْ تَعْلَمُونَ عَظِيمٌ","r":"Wa innahoo laqasamul lawta'lamoona'azeem"},{"n":77,"t":"إِنَّهُۥ لَقُرْءَانٌۭ كَرِيمٌۭ","r":"Innahoo la quraanun kareem"},{"n":78,"t":"فِى كِتَـٰبٍۢ مَّكْنُونٍۢ","r":"Fee kitaabim maknoon"},{"n":79,"t":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ","r":"Laa yamassuhooo illal mutahharoon"},{"n":80,"t":"تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَـٰلَمِينَ","r":"Tanzeelum mir Rabbil'aalameen"},{"n":81,"t":"أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ","r":"Afabihaazal hadeesi antum mudhinoon"},{"n":82,"t":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ","r":"Wa taj'aloona rizqakum annakum tukazziboon"},{"n":83,"t":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ","r":"Falaw laaa izaa balaghatil hulqoom"},{"n":84,"t":"وَأَنتُمْ حِينَئِذٍۢ تَنظُرُونَ","r":"Wa antum heena'izin tanzuroon"},{"n":85,"t":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ","r":"Wa nahnu aqrabu ilaihi minkum wa laakil laa tubsiroon"},{"n":86,"t":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ","r":"Falaw laaa in kuntum ghira madeeneen"},{"n":87,"t":"تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ","r":"Tarji'oonahaaa in kuntum saadiqeen"},{"n":88,"t":"فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ","r":"Fa ammaaa in kaana minal muqarrabeen"},{"n":89,"t":"فَرَوْحٌۭ وَرَيْحَانٌۭ وَجَنَّتُ نَعِيمٍۢ","r":"Farawhunw wa raihaa nunw wa jannatu na'eem"},{"n":90,"t":"وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ","r":"Wa ammaaa in kaana min as haabil yameen"},{"n":91,"t":"فَسَلَـٰمٌۭ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ","r":"Fasalaamul laka min as haabil yameen"},{"n":92,"t":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ","r":"Wa ammaaa in kaana minal mukazzibeenad daaalleen"},{"n":93,"t":"فَنُزُلٌۭ مِّنْ حَمِيمٍۢ","r":"Fanuzulum min hameem"},{"n":94,"t":"وَتَصْلِيَةُ جَحِيمٍ","r":"Wa tasliyatu jaheem"},{"n":95,"t":"إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ","r":"Inna haaza lahuwa haqqul yaqeen"},{"n":96,"t":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","r":"Fasabbih bismi rabbikal 'azeem"}]}