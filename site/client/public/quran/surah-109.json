{"s":109,"a":[{"n":1,"t":"قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ","r":"Qul yaa-ai yuhal kaafiroon"},{"n":2,"t":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","r":"Laa a'budu ma t'abudoon"},{"n":3,"t":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","r":"Wa laa antum 'aabidoona maa a'bud"},{"n":4,"t":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","r":"Wa laa ana 'abidum maa 'abattum"},{"n":5,"t":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","r":"Wa laa antum 'aabidoona ma a'bud"},{"n":6,"t":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","r":"Lakum deenukum wa liya deen."}]}