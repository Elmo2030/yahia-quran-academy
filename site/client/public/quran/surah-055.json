{"s":55,"a":[{"n":1,"t":"ٱلرَّحْمَـٰنُ","r":"Ar Rahmaan"},{"n":2,"t":"عَلَّمَ ٱلْقُرْءَانَ","r":"'Allamal Quran"},{"n":3,"t":"خَلَقَ ٱلْإِنسَـٰنَ","r":"Khalaqal insaan"},{"n":4,"t":"عَلَّمَهُ ٱلْبَيَانَ","r":"'Allamalhul bayaan"},{"n":5,"t":"ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍۢ","r":"Ashshamsu walqamaru bihusbaan"},{"n":6,"t":"وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ","r":"Wannajmu washshajaru yasjudan"},{"n":7,"t":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ","r":"Wassamaaa'a rafa'ahaa wa wada'al Meezan"},{"n":8,"t":"أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ","r":"Allaa tatghaw fil meezaan"},{"n":9,"t":"وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ","r":"Wa aqeemul wazna bilqisti wa laa tukhsirul meezaan"},{"n":10,"t":"وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ","r":"Wal arda wada'ahaa lilanaame"},{"n":11,"t":"فِيهَا فَـٰكِهَةٌۭ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ","r":"Feehaa faakihatunw wan nakhlu zaatul akmaam"},{"n":12,"t":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ","r":"Walhabbu zul 'asfi war Raihaanu"},{"n":13,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan"},{"n":14,"t":"خَلَقَ ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍۢ كَٱلْفَخَّارِ","r":"Khalaqal insaana min salsaalin kalfakhkhaari"},{"n":15,"t":"وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍۢ مِّن نَّارٍۢ","r":"Wa khalaqal jaaan mim maarijim min naar"},{"n":16,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan"},{"n":17,"t":"رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ","r":"Rabbul mashriqayni wa Rabbul maghribayni"},{"n":18,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan"},{"n":19,"t":"مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ","r":"Marajal bahrayni yalta qiyaani"},{"n":20,"t":"بَيْنَهُمَا بَرْزَخٌۭ لَّا يَبْغِيَانِ","r":"Bainahumaa barzakhul laa yabghiyaan"},{"n":21,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan"},{"n":22,"t":"يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ","r":"Yakhruju minhumal lu 'lu u wal marjaanu"},{"n":23,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan"},{"n":24,"t":"وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَـٰمِ","r":"Wa lahul jawaaril mun sha'aatu fil bahri kal a'laam"},{"n":25,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":26,"t":"كُلُّ مَنْ عَلَيْهَا فَانٍۢ","r":"Kullu man 'alaihaa faan"},{"n":27,"t":"وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ","r":"Wa yabqaa wajhu rabbika zul jalaali wal ikraam"},{"n":28,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":29,"t":"يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍۢ","r":"Yas'aluhoo man fissamaawaati walard; kulla ywmin huwa fee shaan"},{"n":30,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":31,"t":"سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ","r":"Sanafrughu lakum ayyuhas saqalaan"},{"n":32,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":33,"t":"يَـٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَـٰنٍۢ","r":"Yaa ma'sharal jinni wal insi inis tata'tum an tanfuzoo min aqtaaris samaawaati wal ardi fanfuzoo; laa tanfuzoona illaa bisultaan"},{"n":34,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":35,"t":"يُرْسَلُ عَلَيْكُمَا شُوَاظٌۭ مِّن نَّارٍۢ وَنُحَاسٌۭ فَلَا تَنتَصِرَانِ","r":"Yursalu 'alaikumaa shuwaazum min naarifiw-wa nuhaasun falaa tantasiraan"},{"n":36,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":37,"t":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةًۭ كَٱلدِّهَانِ","r":"Fa-izan shaqqatis samaaa'u fakaanat wardatan kaddihaan"},{"n":38,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":39,"t":"فَيَوْمَئِذٍۢ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌۭ وَلَا جَآنٌّۭ","r":"Fa-yawma'izil laa yus'alu 'an zambiheee insunw wa laa jaann"},{"n":40,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":41,"t":"يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَـٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ","r":"Yu'raful mujrimoona biseemaahum fa'yu'khazu binna waasi wal aqdaam"},{"n":42,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":43,"t":"هَـٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ","r":"Haazihee jahannamul latee yukazzibu bihal mujrimoon"},{"n":44,"t":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍۢ","r":"Yatoofoona bainahaa wa baina hameemim aan"},{"n":45,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":46,"t":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ","r":"Wa liman khaafa maqaama rabbihee jannataan"},{"n":47,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":48,"t":"ذَوَاتَآ أَفْنَانٍۢ","r":"Zawaataaa afnaan"},{"n":49,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":50,"t":"فِيهِمَا عَيْنَانِ تَجْرِيَانِ","r":"Feehimaa 'aynaani tajriyaan"},{"n":51,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":52,"t":"فِيهِمَا مِن كُلِّ فَـٰكِهَةٍۢ زَوْجَانِ","r":"Feehimaa min kulli faakihatin zawjaan"},{"n":53,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":54,"t":"مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍۢ ۚ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍۢ","r":"Muttaki'eena 'alaa furushim bataaa'inuhaa min istabraq; wajanal jannataini daan"},{"n":55,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":56,"t":"فِيهِنَّ قَـٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ","r":"Feehinna qaasiratut tarfi lam yatmishunna insun qablahum wa laa jaaann"},{"n":57,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":58,"t":"كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ","r":"ka annahunnal yaaqootu wal marjaan"},{"n":59,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":60,"t":"هَلْ جَزَآءُ ٱلْإِحْسَـٰنِ إِلَّا ٱلْإِحْسَـٰنُ","r":"Hal jazaaa'ul ihsaani illal ihsaan"},{"n":61,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":62,"t":"وَمِن دُونِهِمَا جَنَّتَانِ","r":"Wa min doonihimaa jannataan"},{"n":63,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":64,"t":"مُدْهَآمَّتَانِ","r":"Mudhaaammataan"},{"n":65,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":66,"t":"فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ","r":"Feehimaa 'aynaani nad daakhataan"},{"n":67,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":68,"t":"فِيهِمَا فَـٰكِهَةٌۭ وَنَخْلٌۭ وَرُمَّانٌۭ","r":"Feehimaa faakihatunw wa nakhlunw wa rummaan"},{"n":69,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":70,"t":"فِيهِنَّ خَيْرَٰتٌ حِسَانٌۭ","r":"Feehinna khairaatun hisaan"},{"n":71,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":72,"t":"حُورٌۭ مَّقْصُورَٰتٌۭ فِى ٱلْخِيَامِ","r":"Hoorum maqsooraatun fil khiyaam"},{"n":73,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":74,"t":"لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ","r":"Lam yatmis hunna insun qablahum wa laa jaaann"},{"n":75,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":76,"t":"مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍۢ وَعَبْقَرِىٍّ حِسَانٍۢ","r":"Muttaki'eena 'alaa rafratin khudrinw wa 'abqariyyin hisaan"},{"n":77,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","r":"Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan."},{"n":78,"t":"تَبَـٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ","r":"Tabaarakasmu Rabbika Zil-Jalaali wal-Ikraam"}]}