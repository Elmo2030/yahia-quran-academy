{"s":93,"a":[{"n":1,"t":"وَٱلضُّحَىٰ","r":"Wad duhaa"},{"n":2,"t":"وَٱلَّيْلِ إِذَا سَجَىٰ","r":"Wal laili iza sajaa"},{"n":3,"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","r":"Ma wad da'aka rabbuka wa ma qalaa"},{"n":4,"t":"وَلَلْـَٔاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","r":"Walal-aakhiratu khairul laka minal-oola"},{"n":5,"t":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","r":"Wa la sawfa y'uteeka rabbuka fatarda"},{"n":6,"t":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","r":"Alam ya jidka yateeman fa aawaa"},{"n":7,"t":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","r":"Wa wa jadaka daal lan fahada"},{"n":8,"t":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","r":"Wa wa jadaka 'aa-ilan fa aghnaa"},{"n":9,"t":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","r":"Fa am mal yateema fala taqhar"},{"n":10,"t":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","r":"Wa am mas saa-ila fala tanhar"},{"n":11,"t":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","r":"Wa amma bi ni'mati rabbika fahad dith"}]}