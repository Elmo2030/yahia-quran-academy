{"s":87,"a":[{"n":1,"t":"سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","r":"Sabbihisma Rabbikal A'laa"},{"n":2,"t":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","r":"Allazee khalaqa fasawwaa"},{"n":3,"t":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","r":"Wallazee qaddara fahadaa"},{"n":4,"t":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","r":"Wallazeee akhrajal mar'aa"},{"n":5,"t":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","r":"Faja'alahoo ghusaaa'an ahwaa"},{"n":6,"t":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","r":"Sanuqri'uka falaa tansaaa"},{"n":7,"t":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","r":"Illaa maa shaaa'al laah; innahoo ya'lamul jahra wa maa yakhfaa"},{"n":8,"t":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","r":"Wa nu-yassiruka lilyusraa"},{"n":9,"t":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","r":"Fazakkir in nafa'atizzikraa"},{"n":10,"t":"سَيَذَّكَّرُ مَن يَخْشَىٰ","r":"Sa yazzakkaru maiyakhshaa"},{"n":11,"t":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","r":"Wa yatajannabuhal ashqaa"},{"n":12,"t":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","r":"Allazee yaslan Naaral kubraa"},{"n":13,"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","r":"Summa laa yamootu feehaa wa laa yahyaa"},{"n":14,"t":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","r":"Qad aflaha man tazakkaa"},{"n":15,"t":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","r":"Wa zakaras ma Rabbihee fasallaa"},{"n":16,"t":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","r":"Bal tu'siroonal hayaatad dunyaa"},{"n":17,"t":"وَٱلْـَٔاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","r":"Wal Aakhiratu khairunw wa abqaa"},{"n":18,"t":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","r":"Inna haazaa lafis suhu fil oolaa"},{"n":19,"t":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","r":"Suhufi Ibraaheema wa Moosaa"}]}