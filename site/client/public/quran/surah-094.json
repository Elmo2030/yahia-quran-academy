{"s":94,"a":[{"n":1,"t":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","r":"Alam nashrah laka sadrak"},{"n":2,"t":"وَوَضَعْنَا عَنكَ وِزْرَكَ","r":"Wa wa d'ana 'anka wizrak"},{"n":3,"t":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","r":"Allazee anqada zahrak"},{"n":4,"t":"وَرَفَعْنَا لَكَ ذِكْرَكَ","r":"Wa raf 'ana laka zikrak"},{"n":5,"t":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","r":"Fa inna ma'al usri yusra"},{"n":6,"t":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","r":"Inna ma'al 'usri yusra"},{"n":7,"t":"فَإِذَا فَرَغْتَ فَٱنصَبْ","r":"Fa iza faragh ta fansab"},{"n":8,"t":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","r":"Wa ilaa rabbika far ghab"}]}