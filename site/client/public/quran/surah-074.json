{"s":74,"a":[{"n":1,"t":"يَـٰٓأَيُّهَا ٱلْمُدَّثِّرُ","r":"Yaaa ayyuhal muddassir"},{"n":2,"t":"قُمْ فَأَنذِرْ","r":"Qum fa anzir"},{"n":3,"t":"وَرَبَّكَ فَكَبِّرْ","r":"Wa rabbaka fakabbir"},{"n":4,"t":"وَثِيَابَكَ فَطَهِّرْ","r":"Wa siyaabaka fatahhir"},{"n":5,"t":"وَٱلرُّجْزَ فَٱهْجُرْ","r":"Warrujza fahjur"},{"n":6,"t":"وَلَا تَمْنُن تَسْتَكْثِرُ","r":"Wa laa tamnun tastaksir"},{"n":7,"t":"وَلِرَبِّكَ فَٱصْبِرْ","r":"Wa li Rabbika fasbir"},{"n":8,"t":"فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ","r":"Fa izaa nuqira fin naaqoor"},{"n":9,"t":"فَذَٰلِكَ يَوْمَئِذٍۢ يَوْمٌ عَسِيرٌ","r":"Fazaalika yawma 'iziny yawmun 'aseer"},{"n":10,"t":"عَلَى ٱلْكَـٰفِرِينَ غَيْرُ يَسِيرٍۢ","r":"'Alal kaafireena ghayru yaseer"},{"n":11,"t":"ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًۭا","r":"Zamee wa man khalaqtu waheedaa"},{"n":12,"t":"وَجَعَلْتُ لَهُۥ مَالًۭا مَّمْدُودًۭا","r":"Wa ja'altu lahoo maalam mamdoodaa"},{"n":13,"t":"وَبَنِينَ شُهُودًۭا","r":"Wa baneena shuhoodaa"},{"n":14,"t":"وَمَهَّدتُّ لَهُۥ تَمْهِيدًۭا","r":"Wa mahhattu lahoo tamheeda"},{"n":15,"t":"ثُمَّ يَطْمَعُ أَنْ أَزِيدَ","r":"Summa yat ma'u an azeed"},{"n":16,"t":"كَلَّآ ۖ إِنَّهُۥ كَانَ لِـَٔايَـٰتِنَا عَنِيدًۭا","r":"Kallaaa innahoo kaana li Aayaatinaa 'aneedaa"},{"n":17,"t":"سَأُرْهِقُهُۥ صَعُودًا","r":"Sa urhiquhoo sa'oodaa"},{"n":18,"t":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ","r":"Innahoo fakkara wa qaddar"},{"n":19,"t":"فَقُتِلَ كَيْفَ قَدَّرَ","r":"Faqutila kayfa qaddar"},{"n":20,"t":"ثُمَّ قُتِلَ كَيْفَ قَدَّرَ","r":"Summa qutila kaifa qaddar"},{"n":21,"t":"ثُمَّ نَظَرَ","r":"Summa nazar"},{"n":22,"t":"ثُمَّ عَبَسَ وَبَسَرَ","r":"Summa 'abasa wa basar"},{"n":23,"t":"ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ","r":"Summaa adbara wastakbar"},{"n":24,"t":"فَقَالَ إِنْ هَـٰذَآ إِلَّا سِحْرٌۭ يُؤْثَرُ","r":"Faqaala in haazaaa illaa sihruny yu'sar"},{"n":25,"t":"إِنْ هَـٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ","r":"In haazaaa illaa qawlul bashar"},{"n":26,"t":"سَأُصْلِيهِ سَقَرَ","r":"Sa usleehi saqar"},{"n":27,"t":"وَمَآ أَدْرَىٰكَ مَا سَقَرُ","r":"Wa maaa adraaka maa saqar"},{"n":28,"t":"لَا تُبْقِى وَلَا تَذَرُ","r":"Laa tubqee wa laa tazar"},{"n":29,"t":"لَوَّاحَةٌۭ لِّلْبَشَرِ","r":"Lawwaahatul lilbashar"},{"n":30,"t":"عَلَيْهَا تِسْعَةَ عَشَرَ","r":"'Alaihaa tis'ata 'ashar"},{"n":31,"t":"وَمَا جَعَلْنَآ أَصْحَـٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةًۭ ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةًۭ لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَـٰنًۭا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌۭ وَٱلْكَـٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلًۭا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ","r":"Wa maaja''alnaaa As haaban naari illaa malaaa 'ikatanw wa maa ja'alnaa 'iddatahum illaa fitnatal lillazeena kafaroo liyastayqinal lazeena ootul kitaaba wa yazdaadal lazeena aamanooo eemaananw wa laa yartaabal lazeena ootul kitaaba walmu'minoona wa liyaqoolal lazeena fee quloo bihim maradunw walkaafiroona maazaaa araadal laahu bihaazaa masalaa; kazaalika yudillul laahu many yashaaa'u wa yahdee many yashaaa'; wa maa ya'lamu junooda rabbika illaa hoo; wa maa hiya illaa zikraa lil bashar"},{"n":32,"t":"كَلَّا وَٱلْقَمَرِ","r":"Kallaa walqamar"},{"n":33,"t":"وَٱلَّيْلِ إِذْ أَدْبَرَ","r":"Wallaili adbar"},{"n":34,"t":"وَٱلصُّبْحِ إِذَآ أَسْفَرَ","r":"Wassub hi izaaa asfar"},{"n":35,"t":"إِنَّهَا لَإِحْدَى ٱلْكُبَرِ","r":"Innahaa la ihdal kubar"},{"n":36,"t":"نَذِيرًۭا لِّلْبَشَرِ","r":"Nazeeral lilbashar"},{"n":37,"t":"لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ","r":"Liman shaaa'a minkum any yataqaddama aw yata akhkhar"},{"n":38,"t":"كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ","r":"Kullu nafsim bim kasabat raheenah"},{"n":39,"t":"إِلَّآ أَصْحَـٰبَ ٱلْيَمِينِ","r":"Illaaa as haabal yameen"},{"n":40,"t":"فِى جَنَّـٰتٍۢ يَتَسَآءَلُونَ","r":"Fee jannaatiny yata saaa'aloon"},{"n":41,"t":"عَنِ ٱلْمُجْرِمِينَ","r":"'Anil mujrimeen"},{"n":42,"t":"مَا سَلَكَكُمْ فِى سَقَرَ","r":"Maa salakakum fee saqar"},{"n":43,"t":"قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ","r":"Qaaloo lam naku minal musalleen"},{"n":44,"t":"وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ","r":"Wa lam naku nut'imul miskeen"},{"n":45,"t":"وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ","r":"Wa kunnaa nakhoodu ma'al khaaa'ideen"},{"n":46,"t":"وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ","r":"Wa kunnaa nukazzibu bi yawmid Deen"},{"n":47,"t":"حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ","r":"Hattaaa ataanal yaqeen"},{"n":48,"t":"فَمَا تَنفَعُهُمْ شَفَـٰعَةُ ٱلشَّـٰفِعِينَ","r":"Famaa tanfa'uhum shafaa'atush shaafi'een"},{"n":49,"t":"فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ","r":"Famaa lahum 'anittazkirati mu'rideen"},{"n":50,"t":"كَأَنَّهُمْ حُمُرٌۭ مُّسْتَنفِرَةٌۭ","r":"Ka annahum humurum mustanfirah"},{"n":51,"t":"فَرَّتْ مِن قَسْوَرَةٍۭ","r":"Farrat min qaswarah"},{"n":52,"t":"بَلْ يُرِيدُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًۭا مُّنَشَّرَةًۭ","r":"Bal yureedu kullum ri'im minhum any yu'taa suhufam munashsharah"},{"n":53,"t":"كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْـَٔاخِرَةَ","r":"Kallaa bal laa yakhaafoonal aakhirah"},{"n":54,"t":"كَلَّآ إِنَّهُۥ تَذْكِرَةٌۭ","r":"Kallaaa innahoo tazkirah"},{"n":55,"t":"فَمَن شَآءَ ذَكَرَهُۥ","r":"Fa man shaaa'a zakarah"},{"n":56,"t":"وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ","r":"Wa maa yazkuroona illaaa any yashaaa'al laah; Huwa ahlut taqwaa wa ahlul maghfirah"}]}