{"s":100,"a":[{"n":1,"t":"وَٱلْعَـٰدِيَـٰتِ ضَبْحًۭا","r":"Wal'aadi yaati dabha"},{"n":2,"t":"فَٱلْمُورِيَـٰتِ قَدْحًۭا","r":"Fal moori yaati qadha"},{"n":3,"t":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","r":"Fal mugheeraati subha"},{"n":4,"t":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","r":"Fa atharna bihee naq'a"},{"n":5,"t":"فَوَسَطْنَ بِهِۦ جَمْعًا","r":"Fawa satna bihee jam'a"},{"n":6,"t":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","r":"Innal-insana lirabbihee lakanood"},{"n":7,"t":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","r":"Wa innahu 'alaa zaalika la shaheed"},{"n":8,"t":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","r":"Wa innahu lihubbil khairi la shadeed"},{"n":9,"t":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","r":"Afala ya'lamu iza b'uthira ma filquboor"},{"n":10,"t":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","r":"Wa hussila maa fis sudoor"},{"n":11,"t":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","r":"Inna rabbahum bihim yauma 'izil la khabeer"}]}