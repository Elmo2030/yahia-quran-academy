{"s":113,"a":[{"n":1,"t":"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","r":"Qul a'uzoo bi rabbil-falaq"},{"n":2,"t":"مِن شَرِّ مَا خَلَقَ","r":"Min sharri ma khalaq"},{"n":3,"t":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","r":"Wa min sharri ghasiqin iza waqab"},{"n":4,"t":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ","r":"Wa min sharrin-naffaa-thaati fil 'uqad"},{"n":5,"t":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","r":"Wa min shar ri haasidin iza hasad"}]}