{"s":75,"a":[{"n":1,"t":"لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ","r":"Laaa uqsimu bi yawmil qiyaamah"},{"n":2,"t":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","r":"Wa laaa uqsimu bin nafsil lawwaamah"},{"n":3,"t":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","r":"Ayahsabul insaanu al lan najm'a 'izaamah"},{"n":4,"t":"بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","r":"Balaa qaadireena 'alaaa an nusawwiya banaanah"},{"n":5,"t":"بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ","r":"Bal yureedul insaanu liyafjura amaamah"},{"n":6,"t":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ","r":"Yas'alu ayyyaana yawmul qiyaamah"},{"n":7,"t":"فَإِذَا بَرِقَ ٱلْبَصَرُ","r":"Fa izaa bariqal basar"},{"n":8,"t":"وَخَسَفَ ٱلْقَمَرُ","r":"We khasafal qamar"},{"n":9,"t":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","r":"Wa jumi'ash shamusu wal qamar"},{"n":10,"t":"يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","r":"Yaqoolul insaanu yaw ma 'izin aynal mafarr"},{"n":11,"t":"كَلَّا لَا وَزَرَ","r":"Kallaa laa wazar"},{"n":12,"t":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","r":"Ilaa rabbika yawma 'izinil mustaqarr"},{"n":13,"t":"يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","r":"Yunabba 'ul insaanu yawma 'izim bimaa qaddama wa akhkhar"},{"n":14,"t":"بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ","r":"Balil insaanu 'alaa nafsihee baseerah"},{"n":15,"t":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","r":"Wa law alqaa ma'aazeerah"},{"n":16,"t":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","r":"Laa tuharrik bihee lisaa naka lita'jala bih"},{"n":17,"t":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","r":"Inna 'alainaa jam'ahoo wa qur aanah"},{"n":18,"t":"فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","r":"Fa izaa qaraanaahu fattabi' qur aanah"},{"n":19,"t":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","r":"Summa inna 'alainaa bayaanah"},{"n":20,"t":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","r":"Kallaa bal tuhibboonal 'aajilah"},{"n":21,"t":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ","r":"Wa tazaroonal Aakhirah"},{"n":22,"t":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ","r":"Wujoohuny yawma 'izin naadirah"},{"n":23,"t":"إِلَىٰ رَبِّهَا نَاظِرَةٌۭ","r":"Ilaa rabbihaa naazirah"},{"n":24,"t":"وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ","r":"Wa wujoohuny yawma 'izim baasirah"},{"n":25,"t":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ","r":"Tazunnu any yuf'ala bihaa faaqirah"},{"n":26,"t":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","r":"Kallaaa izaa balaghatit taraaqee"},{"n":27,"t":"وَقِيلَ مَنْ ۜ رَاقٍۢ","r":"Wa qeela man raaq"},{"n":28,"t":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","r":"Wa zanna annahul firaaq"},{"n":29,"t":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","r":"Waltaffatis saaqu bissaaq"},{"n":30,"t":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","r":"Ilaa rabbika yawma'izinil masaaq"},{"n":31,"t":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","r":"Falaa saddaqa wa laa sallaa"},{"n":32,"t":"وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ","r":"Wa laakin kazzaba wa tawalla"},{"n":33,"t":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","r":"Summa zahaba ilaaa ahlihee yatamatta"},{"n":34,"t":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","r":"Awlaa laka fa awlaa"},{"n":35,"t":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","r":"Summa awlaa laka fa awla"},{"n":36,"t":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى","r":"Ayahsabul insaanu anyytraka sudaa"},{"n":37,"t":"أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ","r":"Alam yaku nutfatam mim maniyyiny yumnaa"},{"n":38,"t":"ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ","r":"Summa kaana 'alaqata fakhalaq fasawwaa"},{"n":39,"t":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","r":"Faja'ala minhuz zawjayniz zakara wal unsaa"},{"n":40,"t":"أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ","r":"Alaisa zaalika biqaadirin 'alaaa any yuhyiyal mawtaa"}]}