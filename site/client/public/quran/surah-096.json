{"s":96,"a":[{"n":1,"t":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","r":"Iqra bismi rab bikal lazee khalaq"},{"n":2,"t":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","r":"Khalaqal insaana min 'alaq"},{"n":3,"t":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","r":"Iqra wa rab bukal akram"},{"n":4,"t":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","r":"Al lazee 'allama bil qalam"},{"n":5,"t":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ","r":"'Al lamal insaana ma lam y'alam"},{"n":6,"t":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","r":"Kallaa innal insaana layatghaa"},{"n":7,"t":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","r":"Ar-ra aahus taghnaa"},{"n":8,"t":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","r":"Innna ilaa rabbikar ruj'aa"},{"n":9,"t":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","r":"Ara-aital lazee yanhaa"},{"n":10,"t":"عَبْدًا إِذَا صَلَّىٰٓ","r":"'Abdan iza sallaa"},{"n":11,"t":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","r":"Ara-aita in kana 'alal hudaa"},{"n":12,"t":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","r":"Au amara bit taqwaa"},{"n":13,"t":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","r":"Ara-aita in kaz zaba wa ta walla"},{"n":14,"t":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","r":"Alam y'alam bi-an nal lahaa yaraa"},{"n":15,"t":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","r":"Kalla la illam yantahi la nasfa'am bin nasiyah"},{"n":16,"t":"نَاصِيَةٍۢ كَـٰذِبَةٍ خَاطِئَةٍۢ","r":"Nasiyatin kazi batin khaatiyah"},{"n":17,"t":"فَلْيَدْعُ نَادِيَهُۥ","r":"Fal yad'u naadiyah"},{"n":18,"t":"سَنَدْعُ ٱلزَّبَانِيَةَ","r":"Sanad 'uz zabaaniyah"},{"n":19,"t":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","r":"Kalla; la tuti'hu wasjud waqtarib"}]}