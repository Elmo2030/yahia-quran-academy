{"s":101,"a":[{"n":1,"t":"ٱلْقَارِعَةُ","r":"Al qaari'ah"},{"n":2,"t":"مَا ٱلْقَارِعَةُ","r":"Mal qaariah"},{"n":3,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","r":"Wa maa adraaka mal qaari'ah"},{"n":4,"t":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","r":"Yauma ya koonun naasu kal farashil mabthooth"},{"n":5,"t":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","r":"Wa ta koonul jibalu kal 'ihnil manfoosh"},{"n":6,"t":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","r":"Fa-amma man thaqulat mawa zeenuh"},{"n":7,"t":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","r":"Fahuwa fee 'ishatir raadiyah"},{"n":8,"t":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","r":"Wa amma man khaffat mawa zeenuh"},{"n":9,"t":"فَأُمُّهُۥ هَاوِيَةٌۭ","r":"Fa-ummuhu haawiyah"},{"n":10,"t":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","r":"Wa maa adraaka maa hiyah"},{"n":11,"t":"نَارٌ حَامِيَةٌۢ","r":"Naarun hamiyah"}]}