{"s":91,"a":[{"n":1,"t":"وَٱلشَّمْسِ وَضُحَىٰهَا","r":"Wash shamsi wa duhaa haa"},{"n":2,"t":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","r":"Wal qamari izaa talaa haa"},{"n":3,"t":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","r":"Wannahaari izaa jallaa haa"},{"n":4,"t":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","r":"Wallaili izaa yaghshaa haa"},{"n":5,"t":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","r":"Wassamaaa'i wa maa banaahaa"},{"n":6,"t":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","r":"Wal ardi wa maa tahaahaa"},{"n":7,"t":"وَنَفْسٍۢ وَمَا سَوَّىٰهَا","r":"Wa nafsinw wa maa sawwaahaa"},{"n":8,"t":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","r":"Fa-alhamahaa fujoorahaa wa taqwaahaa"},{"n":9,"t":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","r":"Qad aflaha man zakkaahaa"},{"n":10,"t":"وَقَدْ خَابَ مَن دَسَّىٰهَا","r":"Wa qad khaaba man dassaahaa"},{"n":11,"t":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","r":"Kazzabat Samoodu bi taghwaahaaa"},{"n":12,"t":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","r":"Izim ba'asa ashqaahaa"},{"n":13,"t":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا","r":"Faqaala lahum Rasoolul laahi naaqatal laahi wa suqiyaahaa"},{"n":14,"t":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","r":"Fakazzaboohu fa'aqaroohaa fadamdama 'alaihim Rabbuhum bizambihim fasaw waahaa"},{"n":15,"t":"وَلَا يَخَافُ عُقْبَـٰهَا","r":"Wa laa yakhaafu'uqbaahaa"}]}