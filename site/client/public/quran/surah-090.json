{"s":90,"a":[{"n":1,"t":"لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ","r":"Laaa uqsimu bihaazal balad"},{"n":2,"t":"وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ","r":"Wa anta hillum bihaazal balad"},{"n":3,"t":"وَوَالِدٍۢ وَمَا وَلَدَ","r":"Wa waalidinw wa maa walad"},{"n":4,"t":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ","r":"Laqad khalaqnal insaana fee kabad"},{"n":5,"t":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ","r":"Ayahsabu al-lai yaqdira 'alaihi ahad"},{"n":6,"t":"يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا","r":"Yaqoolu ahlaktu maalal lubadaa"},{"n":7,"t":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ","r":"Ayahsabu al lam yarahooo ahad"},{"n":8,"t":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ","r":"Alam naj'al lahoo 'aynayn"},{"n":9,"t":"وَلِسَانًۭا وَشَفَتَيْنِ","r":"Wa lisaananw wa shafatayn"},{"n":10,"t":"وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ","r":"Wa hadaynaahun najdayn"},{"n":11,"t":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ","r":"Falaq tahamal-'aqabah"},{"n":12,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ","r":"Wa maaa adraaka mal'aqabah"},{"n":13,"t":"فَكُّ رَقَبَةٍ","r":"Fakku raqabah"},{"n":14,"t":"أَوْ إِطْعَـٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ","r":"Aw it'aamun fee yawmin zee masghabah"},{"n":15,"t":"يَتِيمًۭا ذَا مَقْرَبَةٍ","r":"Yateeman zaa maqrabah"},{"n":16,"t":"أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ","r":"Aw miskeenan zaa matrabah"},{"n":17,"t":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ","r":"Summa kaana minal lazeena aamanoo wa tawaasaw bissabri wa tawaasaw bilmarhamah"},{"n":18,"t":"أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ","r":"Ulaaa'ika As-haabul maimanah"},{"n":19,"t":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ","r":"Wallazeena kafaroo bi aayaatinaa hum as-haabul Mash'amah"},{"n":20,"t":"عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ","r":"Alaihim naarum mu'sadah"}]}