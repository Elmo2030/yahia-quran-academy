{"s":107,"a":[{"n":1,"t":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","r":"Ara-aital lazee yu kazzibu bid deen"},{"n":2,"t":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","r":"Fa zaalikal lazi yadu'ul-yateem"},{"n":3,"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","r":"Wa la ya huddu 'alaa ta'amil miskeen"},{"n":4,"t":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","r":"Fa wai lul-lil mu salleen"},{"n":5,"t":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","r":"Al lazeena hum 'an salaatihim sahoon"},{"n":6,"t":"ٱلَّذِينَ هُمْ يُرَآءُونَ","r":"Al lazeena hum yuraa-oon"},{"n":7,"t":"وَيَمْنَعُونَ ٱلْمَاعُونَ","r":"Wa yamna'oonal ma'oon"}]}