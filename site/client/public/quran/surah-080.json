{"s":80,"a":[{"n":1,"t":"عَبَسَ وَتَوَلَّىٰٓ","r":"'Abasa wa tawallaa."},{"n":2,"t":"أَن جَآءَهُ ٱلْأَعْمَىٰ","r":"An jaa-ahul 'a-maa"},{"n":3,"t":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","r":"Wa maa yudreeka la'allahu yaz zakkaa."},{"n":4,"t":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","r":"Au yaz zak karu fatanfa 'ahuz zikraa."},{"n":5,"t":"أَمَّا مَنِ ٱسْتَغْنَىٰ","r":"Amma manis taghnaa"},{"n":6,"t":"فَأَنتَ لَهُۥ تَصَدَّىٰ","r":"Fa-anta lahu tasaddaa"},{"n":7,"t":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","r":"Wa ma 'alaika allaa yaz zakka."},{"n":8,"t":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","r":"Wa amma man jaa-aka yas'a"},{"n":9,"t":"وَهُوَ يَخْشَىٰ","r":"Wahuwa yakhshaa,"},{"n":10,"t":"فَأَنتَ عَنْهُ تَلَهَّىٰ","r":"Fa-anta 'anhu talah haa."},{"n":11,"t":"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","r":"Kalla innaha tazkirah"},{"n":12,"t":"فَمَن شَآءَ ذَكَرَهُۥ","r":"Faman shaa a zakarah"},{"n":13,"t":"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","r":"Fi suhufim mukar rama,"},{"n":14,"t":"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","r":"Marfoo'atim mutah hara,"},{"n":15,"t":"بِأَيْدِى سَفَرَةٍۢ","r":"Bi'aidee safara"},{"n":16,"t":"كِرَامٍۭ بَرَرَةٍۢ","r":"Kiraamim bararah."},{"n":17,"t":"قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ","r":"Qutilal-insanu maa akfarah."},{"n":18,"t":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","r":"Min aiyyi shai-in Khalaq"},{"n":19,"t":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","r":"Min nutfah; khalaqahu faqad-darah."},{"n":20,"t":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","r":"Thummas sabeela yas-sarah"},{"n":21,"t":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","r":"Thumma amatahu fa-aqbarah"},{"n":22,"t":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","r":"Thumma iza shaa-a ansharah"},{"n":23,"t":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","r":"Kalla lamma yaqdi maa amarah."},{"n":24,"t":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ","r":"Falyanzuril insanu ilaa ta-amih"},{"n":25,"t":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا","r":"Anna sabab nalmaa-a sabba."},{"n":26,"t":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا","r":"Thumma sha qaqnal-arda shaqqa."},{"n":27,"t":"فَأَنۢبَتْنَا فِيهَا حَبًّۭا","r":"Fa ambatna feeha habba"},{"n":28,"t":"وَعِنَبًۭا وَقَضْبًۭا","r":"Wa 'inabaw-wa qadba"},{"n":29,"t":"وَزَيْتُونًۭا وَنَخْلًۭا","r":"Wa zaitoonaw wanakh la'"},{"n":30,"t":"وَحَدَآئِقَ غُلْبًۭا","r":"Wa hadaa-iqa ghulba"},{"n":31,"t":"وَفَـٰكِهَةًۭ وَأَبًّۭا","r":"Wa faki hataw-wa abba."},{"n":32,"t":"مَّتَـٰعًۭا لَّكُمْ وَلِأَنْعَـٰمِكُمْ","r":"Mata'al-lakum wa li-an'amikum."},{"n":33,"t":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","r":"Faiza jaa-atis saakhah."},{"n":34,"t":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","r":"Yauma yafir-rul mar-u min akheeh"},{"n":35,"t":"وَأُمِّهِۦ وَأَبِيهِ","r":"Wa ummihee wa abeeh"},{"n":36,"t":"وَصَـٰحِبَتِهِۦ وَبَنِيهِ","r":"Wa sahi batihee wa baneeh."},{"n":37,"t":"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ","r":"Likul limri-im-minuhm yaumaa-izin shaa nuy-yughneeh"},{"n":38,"t":"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ","r":"Wujoo huny-yauma-izim-musfira;"},{"n":39,"t":"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ","r":"Dahi katum mustab shirah"},{"n":40,"t":"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ","r":"Wa wujoohuy yauma-izin 'alaiha ghabar a"},{"n":41,"t":"تَرْهَقُهَا قَتَرَةٌ","r":"Tarhaquha qatarah."},{"n":42,"t":"أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","r":"Ulaa-ika humul-kafa ratul-fajarah."}]}