{"s":88,"a":[{"n":1,"t":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ","r":"Hal ataaka hadeesul ghaashiyah"},{"n":2,"t":"وُجُوهٌۭ يَوْمَئِذٍ خَـٰشِعَةٌ","r":"Wujoohuny yawma 'izin khaashi'ah"},{"n":3,"t":"عَامِلَةٌۭ نَّاصِبَةٌۭ","r":"'Aamilatun naasibah"},{"n":4,"t":"تَصْلَىٰ نَارًا حَامِيَةًۭ","r":"Taslaa naaran haamiyah"},{"n":5,"t":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","r":"Tusqaa min 'aynin aaniyah"},{"n":6,"t":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","r":"Laisa lahum ta'aamun illaa min daree'"},{"n":7,"t":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","r":"Laa yusminu wa laa yughnee min joo'"},{"n":8,"t":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","r":"Wujoohuny yawma 'izin naa'imah"},{"n":9,"t":"لِّسَعْيِهَا رَاضِيَةٌۭ","r":"Lisa'yihaa raadiyah"},{"n":10,"t":"فِى جَنَّةٍ عَالِيَةٍۢ","r":"Fee jannatin 'aaliyah"},{"n":11,"t":"لَّا تَسْمَعُ فِيهَا لَـٰغِيَةًۭ","r":"Laa tasma'u feehaa laaghiyah"},{"n":12,"t":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","r":"Feehaa 'aynun jaariyah"},{"n":13,"t":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","r":"Feehaa sururum marfoo'ah"},{"n":14,"t":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","r":"Wa akwaabum mawdoo 'ah"},{"n":15,"t":"وَنَمَارِقُ مَصْفُوفَةٌۭ","r":"Wa namaariqu masfoofah"},{"n":16,"t":"وَزَرَابِىُّ مَبْثُوثَةٌ","r":"Wa zaraabiyyu mabsoosah"},{"n":17,"t":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","r":"Afalaa yanzuroona ilalibili kaifa khuliqat"},{"n":18,"t":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","r":"Wa ilas samaaa'i kaifa rufi'at"},{"n":19,"t":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","r":"Wa ilal jibaali kaifa nusibat"},{"n":20,"t":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","r":"Wa ilal ardi kaifa sutihat"},{"n":21,"t":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","r":"Fazakkir innama anta Muzakkir"},{"n":22,"t":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","r":"Lasta 'alaihim bimusaitir"},{"n":23,"t":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","r":"Illaa man tawallaa wa kafar"},{"n":24,"t":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","r":"Fa yu'azzibuhul laahul 'azaabal akbar"},{"n":25,"t":"إِنَّ إِلَيْنَآ إِيَابَ