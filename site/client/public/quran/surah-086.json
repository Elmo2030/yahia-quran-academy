{"s":86,"a":[{"n":1,"t":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","r":"Wassamaaa'i wattaariq"},{"n":2,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","r":"Wa maaa adraaka mattaariq"},{"n":3,"t":"ٱلنَّجْمُ ٱلثَّاقِبُ","r":"Annajmus saaqib"},{"n":4,"t":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","r":"In kullu nafsil lammaa 'alaihaa haafiz"},{"n":5,"t":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ","r":"Fal yanzuril insaanu mimma khuliq"},{"n":6,"t":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","r":"Khuliqa mim maaa'in daafiq"},{"n":7,"t":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","r":"Yakhruju mim bainissulbi wat taraaa'ib"},{"n":8,"t":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","r":"Innahoo 'alaa raj'ihee laqaadir"},{"n":9,"t":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","r":"Yawma tublas saraaa'ir"},{"n":10,"t":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","r":"Famaa lahoo min quwwatinw wa laa naasir"},{"n":11,"t":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","r":"Wassamaaa'i zaatir raj'"},{"n":12,"t":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","r":"Wal ardi zaatis sad'"},{"n":13,"t":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","r":"Innahoo laqawlun fasl"},{"n":14,"t":"وَمَا هُوَ بِٱلْهَزْلِ","r":"Wa maa huwa bil hazl"},{"n":15,"t":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","r":"Innahum yakeedoona kaidaa"},{"n":16,"t":"وَأَكِيدُ كَيْدًۭا","r":"Wa akeedu kaidaa"},{"n":17,"t":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","r":"Famahhilil kaafireena amhilhum ruwaidaa"}]}