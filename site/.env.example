# ------------------------------------------------------------------------------
# Public configuration for the Yahia Quran Academy website (site/).
#
# Local development: copy this file to site/.env.local and fill in real values.
# Production: set these as Cloudflare Pages → Settings → Environment variables.
# NEVER commit real credentials — the anon key is public by design, the
# service_role key must never leave the Supabase dashboard.
#
# The real values come from:
#   https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="<replace-with-anon-public-key-from-supabase-dashboard>"

# Which OAuth providers Supabase has enabled, comma separated. Defaults to
# "google". Apple stays off until the provider is enabled in the Supabase
# dashboard — a button for a disabled provider fails with
# "provider is not enabled" and the user can do nothing about it.
VITE_AUTH_PROVIDERS="google"

# Optional Umami analytics. Leave empty to disable — the site emits no
# analytics <script> when these are unset.
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""

# Canonical origin used when generating sitemap.xml (defaults to the live domain).
SITE_ORIGIN="https://your-domain.example"

# Address shown on the privacy page so visitors without an account can reach
# someone about their data. Leave empty to hide the line.
VITE_PRIVACY_CONTACT_EMAIL=""
