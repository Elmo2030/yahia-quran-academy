# ------------------------------------------------------------------------------
# Public configuration for the Yahia Quran Academy website (site/).
#
# Local development: copy this file to site/.env.local and fill in real values.
# Production: set these as Cloudflare Pages → Settings → Environment variables.
# NEVER commit real credentials — the anon key is public by design, the
# service_role key must never leave the Supabase dashboard.
#
# The real values come from:
#   https://supabase.com/dashboard/project/rhcfcyvxgbltdzeezryw/settings/api
# ------------------------------------------------------------------------------

VITE_SUPABASE_URL="https://rhcfcyvxgbltdzeezryw.supabase.co"
VITE_SUPABASE_ANON_KEY="<replace-with-anon-public-key-from-supabase-dashboard>"

# Optional Umami analytics. Leave empty to disable — the site emits no
# analytics <script> when these are unset.
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""

# Canonical origin used when generating sitemap.xml (defaults to the pages.dev URL).
SITE_ORIGIN="https://yahia-quran-academy.pages.dev"
