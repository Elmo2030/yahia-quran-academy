*.pyc

# Env files (never commit real secrets)
.env

# Wrangler local state (Cloudflare CLI)
.wrangler/

# Site build output
site/dist/
site/node_modules/

# Generated beside the function at build time
site/functions/page-data.js

# Source art for the memorization journey (~180 MB). Only the WebP ladders
# under site/client/public/hifz-art/ ship; build them with
# node site/scripts/build-hifz-art.mjs "صور-رحلة-الحفظ/hifz-art"
/صور-رحلة-الحفظ/

# Raw art drops and downloaded audio: worked on by hand, never committed.
/downloaded-assets/

# The Minshawi murattal mushaf (3 GB with the zip): it lives on R2, not in git.
/المنشاوي المرتل\ /
